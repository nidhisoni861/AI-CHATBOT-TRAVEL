# ── Hugging Face authentication ───────────────────────────────────────────────
# Required for gated models (LLaMA, Mistral, etc.)
HF_TOKEN=your_huggingface_token

# ── Model identity ────────────────────────────────────────────────────────────
BASE_MODEL_ID=unsloth/Llama-3.2-3B-Instruct

# ── LoRA adapter ──────────────────────────────────────────────────────────────
# Adapter checkpoint source — dataset repos are downloaded locally for PEFT
ADAPTER_REPO_ID=Naman-1718/wanderly-training-backup
ADAPTER_REPO_TYPE=dataset
ADAPTER_SUBFOLDER=wanderly-3b-lora/checkpoint-1952

# Optional: absolute local path to a pre-downloaded adapter folder
LOCAL_ADAPTER_PATH=

# ── Runtime settings ──────────────────────────────────────────────────────────
MODEL_TEMPERATURE=0.0
MODEL_MAX_INPUT_TOKENS=2000
MODEL_MAX_NEW_TOKENS=2200

# Which model variant to preload on startup: fine_tuned | base | none
BACKEND_PRELOAD_MODEL=fine_tuned

# ── Server ────────────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=9000

# ── Debug (development only — never true in production) ───────────────────────
WANDERLY_DEBUG_RAW_OUTPUT=false
