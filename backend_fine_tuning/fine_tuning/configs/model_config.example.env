# Option B: Load adapter from local extracted checkpoint.
# LOCAL_ADAPTER_PATH=backend_fine_tuning/fine_tuning/checkpoints/checkpoint-1952

MERGED_MODEL_REPO_ID=Naman-1718/wanderly-llama32-3b-merged

MODEL_TEMPERATURE=0.2
MODEL_MAX_NEW_TOKENS=900
