# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Python / ML
__pycache__/
*.pyc

# Python virtual environments
venv/
backend/venv/
**/venv/

# Python cache
**pycache__/
**/**pycache__/
*.pyc

# Environment files
.env
backend/.env

# env files (can opt-in for committing if needed)
.env*
!.env.example
!/backend_fine_tuning/.env.example
!/backend_fine_tuning/fine_tuning/configs/model_config.example.env
/backend_fine_tuning/.env
/backend_fine_tuning/.venv/
/backend_fine_tuning/.venv-linux/
/backend_fine_tuning/.tmp/
/backend_fine_tuning/fine_tuning/scripts/__pycache__/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local archive for files not used by the fine-tuning backend
/extra_app/
/new_backend/

# fine-tuning dataset files (large, local-only)
/backend_fine_tuning/fine_tuning/data/processed/*.jsonl
/backend_fine_tuning/fine_tuning/data/raw/

# fine-tuning outputs and model artifacts
/backend_fine_tuning/fine_tuning/outputs/*
!/backend_fine_tuning/fine_tuning/outputs/.gitkeep
/backend_fine_tuning/fine_tuning/scripts/merged_model/
/backend_fine_tuning/merged_model/
/backend_fine_tuning/fine_tuning/checkpoints/
checkpoint-*/
*.safetensors
*.pt
*.pth
*.bin

# Optional backend evaluation scripts
/backend_fine_tuning/fine_tuning/scripts/_test_guardrail_rules.py
/backend_fine_tuning/fine_tuning/scripts/create_10_train_questions.py
/backend_fine_tuning/fine_tuning/scripts/run_10_backend_comparison.py
/backend_fine_tuning/fine_tuning/scripts/run_7_question_model_switch_test.py
/backend_fine_tuning/fine_tuning/scripts/run_quality_check_2_prompts.py

# Optional backend evaluation scripts
/backend_fine_tuning/fine_tuning/scripts/_test_guardrail_rules.py
/backend_fine_tuning/fine_tuning/scripts/create_10_train_questions.py
/backend_fine_tuning/fine_tuning/scripts/run_10_backend_comparison.py
/backend_fine_tuning/fine_tuning/scripts/run_7_question_model_switch_test.py
/backend_fine_tuning/fine_tuning/scripts/run_quality_check_2_prompts.py
