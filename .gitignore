# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Python / ML
__pycache__/
*.pyc

# env files (can opt-in for committing if needed)
.env*
!.env.example
!/backend/.env.example
!/backend/fine_tuning/configs/model_config.example.env
/backend/.env
/backend/fine_tuning/scripts/__pycache__/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local archive for files not used by the fine-tuning backend
/extra_app/
/new_backend/

# fine-tuning outputs and model artifacts
/backend/fine_tuning/outputs/*
!/backend/fine_tuning/outputs/.gitkeep
/backend/fine_tuning/scripts/merged_model/
/backend/merged_model/
/backend/fine_tuning/checkpoints/
checkpoint-*/
*.safetensors
*.pt
*.pth
*.bin
